        </xacro:unless>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:unless>
    <xacro:unless value="$(arg weld_upper)">
      <joint name="right_shoulder_pitch_joint">
        <xacro:if value="$(arg walk_mode)">
          <command_interface name="effort"/>
        </xacro:if>
        <xacro:unless value="$(arg walk_mode)">
          <command_interface name="position"/>
        </xacro:unless>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:unless>
    <xacro:unless value="$(arg weld_upper)">
